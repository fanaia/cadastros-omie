      { "code": "operator", "name": "Operador", "description": "Consulta e mantém cadastros nas conexões autorizadas.", "permissions": ["cadastros.partner.read.connection", "cadastros.partner.write.connection", "cadastros.category.read.connection", "cadastros.department.read.connection", "cadastros.project.read.connection", "cadastros.project.write.connection", "cadastros.attachment.read.connection", "cadastros.picker.read.connection", "cadastros.audit.read"] },
      { "code": "developer", "name": "Desenvolvedor", "description": "Implementa e valida contratos, sincronização e mapeamentos.", "permissions": ["cadastros.partner.read.connection", "cadastros.partner.sync.connection", "cadastros.category.read.connection", "cadastros.category.sync.connection", "cadastros.department.read.connection", "cadastros.department.sync.connection", "cadastros.project.read.connection", "cadastros.project.sync.connection", "cadastros.attachment.read.connection", "cadastros.picker.read.connection", "cadastros.audit.read"] },
