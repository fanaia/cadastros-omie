  "appKind": "member-central",
  "backend": { "metadataUrl": "/core/metadata" },
  "layout": { "shell": "default", "sidebar": "core", "topbar": "core", "footer": "core" },
  "navigation": { "mode": "auto" },
  "pages": [
    {
      "path": "/",
      "label": "Visão operacional",
      "title": "Operação dos cadastros Omie",
      "order": 10,
      "blocks": [
        { "type": "markdown", "content": "Localize cadastros na base correta, valide a origem e concentre o trabalho em pendências, conflitos e erros de sincronização.\n\n**Jornada recomendada:** escolher a base → localizar → qualificar → validar origem e sincronização → tratar exceções.\n\n[Abrir clientes e fornecedores](/clientes-fornecedores)" },
        { "type": "section", "title": "Como priorizar o trabalho", "description": "A situação de sincronização define o próximo passo.", "blocks": [
          { "type": "markdown", "content": "1. Selecione a conexão Omie autorizada.\n2. Filtre **Conflito**, **Erro** ou **Pendente**.\n3. Use **Analisar sincronização** para abrir a ocorrência no contexto correto.\n4. Confira o cadastro funcional antes dos ids técnicos e do hash." }
        ] },
        { "type": "section", "title": "Fonte de verdade e segurança", "description": "As projeções apoiam a operação sem substituir o ERP.", "blocks": [
          { "type": "markdown", "content": "• O Omie permanece fonte de verdade.\n• Toda projeção preserva a conexão de origem.\n• O adapter pertence a este side-car e a integração nativa do Core está desabilitada.\n• Sincronizar, reprocessar e resolver conflito só serão exibidos após os comandos protegidos estarem homologados." }
        ] }
      ]
    }
  ],
  "collections": [
    {
      "model": "PartnerProjection",
      "mode": "dynamic",
      "path": "/clientes-fornecedores",
      "label": "Clientes e fornecedores",
      "section": "Operação",
      "list": {
        "filters": [
          { "field": "omieConnectionId", "label": "Base Omie", "type": "text" },
          { "field": "syncState", "label": "Situação", "type": "select", "options": [
            { "label": "Todas", "value": "" }, { "label": "Pendente", "value": "Pendente" }, { "label": "Sincronizando", "value": "Sincronizando" }, { "label": "Sincronizado", "value": "Sincronizado" }, { "label": "Conflito", "value": "Conflito" }, { "label": "Erro", "value": "Erro" }, { "label": "Inativo", "value": "Inativo" }
          ] },
          { "field": "isCustomer", "label": "Cliente", "type": "boolean" },
          { "field": "isSupplier", "label": "Fornecedor", "type": "boolean" },
          { "field": "active", "label": "Ativo", "type": "boolean" }
        ],
        "columns": [
          { "field": "legalName", "label": "Razão social" },
          { "field": "tradeName", "label": "Nome fantasia" },
          { "field": "documentMasked", "label": "Documento" },
          { "field": "isCustomer", "label": "Cliente", "format": "badge", "width": 90 },
          { "field": "isSupplier", "label": "Fornecedor", "format": "badge", "width": 110 },
          { "field": "omieConnectionId", "label": "Base Omie" },
          { "field": "syncState", "label": "Situação", "format": "badge", "width": 130 },
          { "field": "syncedAt", "label": "Última sync", "format": "date", "width": 150 }
        ],
        "rowActions": [
          { "id": "analisarSincronizacao", "type": "openDetailModal", "label": "Analisar sincronização", "icon": "alert-triangle", "initialTab": "sincronizacao", "hiddenWhen": { "field": "syncState", "in": ["Sincronizado", "Inativo"] }, "permissions": ["cadastros.partner.read.connection"] },
          { "id": "consultarCadastro", "type": "openDetailModal", "label": "Consultar cadastro", "icon": "search", "initialTab": "resumo", "permissions": ["cadastros.partner.read.connection"] }
        ]
      },
      "detailModal": {
        "enabled": true,
        "titleField": "legalName",
        "size": "xl",
        "defaultTab": "resumo",
        "tabs": [
          { "id": "resumo", "label": "Resumo operacional", "type": "summary", "cards": [
            { "label": "Situação", "field": "syncState", "format": "badge" },
            { "label": "Ativo", "field": "active", "format": "badge" },
            { "label": "Cliente", "field": "isCustomer", "format": "badge" },
            { "label": "Fornecedor", "field": "isSupplier", "format": "badge" },
            { "label": "Base Omie", "field": "omieConnectionId", "format": "text" },
            { "label": "Última sincronização", "field": "syncedAt", "format": "date" }
          ] },
          { "id": "cadastro", "label": "Cadastro", "type": "form", "groups": [
            { "label": "Identificação", "fields": ["legalName", "tradeName", "documentMasked", "active"] },
            { "label": "Papéis", "fields": ["isCustomer", "isSupplier"] },
            { "label": "Contato", "fields": ["email", "phone"] }
          ] },
          { "id": "origem", "label": "Origem", "type": "form", "groups": [
            { "label": "Rastreabilidade Omie", "fields": ["omieConnectionId", "externalId", "integrationCode", "externalUpdatedAt"] }
          ] },
          { "id": "sincronizacao", "label": "Sincronização", "type": "form", "groups": [
            { "label": "Situação", "fields": ["syncState", "syncedAt", "lastErrorCode"] },
            { "label": "Integridade", "fields": ["payloadHash"] }
          ] }
        ]
      }
